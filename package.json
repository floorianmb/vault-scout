{
  "name": "vault-scout",
  "version": "0.1.0",
  "description": "Research your vault with ChatGPT using your own ChatGPT plan, on desktop and mobile.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",

  },
  "keywords": [
    "obsidian",
    "chatgpt",
    "research"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.1"
  }
}
